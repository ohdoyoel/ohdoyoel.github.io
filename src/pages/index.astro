---
import BaseLayout from '../layouts/BaseLayout.astro';
import Menu from '../components/Menu.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import { useTranslations, pageLink, assetLink } from '../i18n/utils';
import { profile } from '../data/profile';
import { projects } from '../data/project';
import { papers } from '../data/publication';
import { blogPosts } from '../data/blog';
import type { Entry as EntryType } from '../data/types';

const lang = 'en' as const;
const t = useTranslations(lang);
const featuredPapers = papers.slice(0, 5);
const featuredProjects: EntryType[] = projects.slice(0, 5).map((p) => ({
  ...p,
  link: { href: pageLink(lang, `project/${p.id}`), internal: true },
}));
const featuredBlogs: EntryType[] = blogPosts.slice(0, 5).map((p) => ({
  period: p.period,
  title: p.title,
  description: p.description,
  link: { href: pageLink(lang, `blog/${p.id}`), internal: true },
}));
---
<BaseLayout
  lang={lang}
  title={`${profile.name[lang]} — CV`}
  description="Curriculum vitae and personal site."
>
  <r-grid class="main" columns="6" columns-s="4" columns-xs="2">
    <r-cell order="-10" span="4" span-s="row">
      <h1>{t('hero.about')} {profile.name[lang]}</h1>
      <p class="cv-link"><a href={assetLink('cv_ohdoyeol.pdf')} target="_blank" rel="noopener noreferrer">{t('nav.cv')} (PDF)</a></p>
    </r-cell>

    <r-cell order="-9" class="menu" span="2" span-s="row">
      <Menu lang={lang} current="home" />
    </r-cell>

    <r-cell span="2">
      <Section title={t('section.paper')}>
        {featuredPapers.map((e) => <Entry entry={e} lang={lang} compact />)}
      </Section>
      <p class="see-all"><a href={pageLink(lang, 'publication')} class="dimmed">See all publications →</a></p>
    </r-cell>

    <r-cell span="2">
      <Section title={t('section.project')}>
        {featuredProjects.map((e) => <Entry entry={e} lang={lang} compact />)}
      </Section>
      <p class="see-all"><a href={pageLink(lang, 'project')} class="dimmed">See all projects →</a></p>
    </r-cell>

    <r-cell span="2" span-s="3" span-xs="row">
      <Section title={t('section.blog')}>
        {featuredBlogs.map((e) => <Entry entry={e} lang={lang} compact />)}
      </Section>
      <p class="see-all"><a href={pageLink(lang, 'blog')} class="dimmed">See all posts →</a></p>
    </r-cell>
  </r-grid>
</BaseLayout>

<style>
  .cv-link {
    margin-top: calc(var(--unit) * 1);
    font-size: var(--font-size-2);
    color: var(--menu-inactive-color);
  }
  .cv-link a {
    color: inherit;
  }
  .cv-link a:hover {
    color: var(--menu-active-color);
  }
  .see-all {
    margin-top: calc(var(--unit) * 2);
    font-size: var(--font-size-2);
  }
</style>
