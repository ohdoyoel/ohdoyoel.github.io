---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Menu from '../../components/Menu.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { useTranslations, pageLink } from '../../i18n/utils';
import { profile } from '../../data/profile';
import { projects } from '../../data/project';
import type { Project } from '../../data/types';

const lang = 'ko' as const;
const t = useTranslations(lang);

const entries: Project[] = projects.map((p) => ({
  ...p,
  link: { href: pageLink(lang, `project/${p.id}`), internal: true },
}));
---
<BaseLayout
  lang={lang}
  pageClass="page-project"
  title={`${t('page.project')} — ${profile.name[lang]}`}
>
  <r-grid class="main" columns="6" columns-s="4" columns-xs="2">
    <r-cell order="-10" span="4" span-s="row">
      <h1>{t('page.project.heading')}</h1>
    </r-cell>
    <r-cell order="-9" class="menu" span="2" span-s="row">
      <Menu lang={lang} current="project" />
    </r-cell>
    {entries.map((e) => (
      <r-cell span="2" span-s="row">
        <ProjectCard entry={e} lang={lang} />
      </r-cell>
    ))}
  </r-grid>
</BaseLayout>
