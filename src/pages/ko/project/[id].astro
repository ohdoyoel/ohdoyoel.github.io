---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Menu from '../../../components/Menu.astro';
import { useTranslations, pageLink, assetLink } from '../../../i18n/utils';
import { profile } from '../../../data/profile';
import { projects } from '../../../data/project';

export const getStaticPaths = (() => {
  return projects.map((p) => ({ params: { id: String(p.id) }, props: { post: p } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const lang = 'ko' as const;
const t = useTranslations(lang);

const modules = import.meta.glob<any>('../../../content/project/*.ko.md', { eager: true });
const Content = modules[`../../../content/project/${post.id}.ko.md`]?.Content;

const period = post.period.replace(/Present/g, t('meta.present'));

const isAbsolute = (s: string) => /^([a-z]+:)?\/\//i.test(s) || s.startsWith('/') || s.startsWith('data:');
const resolveHref = (s: string) => (s.startsWith('#') || isAbsolute(s) ? s : assetLink(s));
const imageSrc = post.image && resolveHref(post.image.src);
const imageAlt = post.image?.alt?.[lang] ?? post.title[lang];
---
<BaseLayout
  lang={lang}
  pageClass="page-project"
  title={`${post.title[lang]} — ${profile.name[lang]}`}
>
  <r-grid class="main post" columns="6" columns-s="4">
    <r-cell order="-10" span="4" span-s="2">
      <h1>{t('page.project.heading')}</h1>
    </r-cell>
    <r-cell order="-9" class="menu" span="2" span-s="2">
      <Menu lang={lang} current="project" />
    </r-cell>

    <r-cell span="1" span-s="2">
      <a class="back-arrow" href={pageLink(lang, 'project')} aria-label={t('page.project')}>←</a>
    </r-cell>
    <r-cell class="post-meta-cell" span="5" span-s="2">
      <time class="post-period">{period}</time>
    </r-cell>

    <r-cell span="2+4" span-s="row">
      {post.subtitle && <p class="post-subtitle">{post.subtitle[lang]}</p>}
      <h2 class="post-title">{post.title[lang]}</h2>
    </r-cell>

    <r-cell class="post-body-cell" span="2+4" span-s="row">
      {post.description && <p class="post-description">{post.description[lang]}</p>}
      {imageSrc && (
        <div class="post-image">
          <img src={imageSrc} alt={imageAlt} loading="lazy" />
        </div>
      )}
      <article class="post-body">
        {Content ? <Content /> : <p class="post-empty">(내용이 없습니다)</p>}
      </article>
    </r-cell>
  </r-grid>
</BaseLayout>

<style>
  .back-arrow {
    display: inline-block;
    font-size: var(--font-size-9);
    line-height: var(--line-height-9);
    letter-spacing: var(--letter-spacing-9);
    color: var(--foreground-color);
    font-weight: 600;
  }
  .back-arrow:hover {
    background-color: transparent;
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
    color: var(--foreground-color-dimmed);
    text-decoration: none;
  }
  .post-meta-cell {
    display: flex;
    justify-content: flex-end;
    align-items: baseline;
  }
  .post-period {
    font-size: var(--font-size-1);
    line-height: var(--line-height-1);
    letter-spacing: var(--letter-spacing-1);
    color: var(--foreground-color-dimmed);
    white-space: nowrap;
  }
  .post-subtitle {
    font-size: var(--font-size-1);
    line-height: var(--line-height-1);
    letter-spacing: var(--letter-spacing-1);
    color: var(--foreground-color-dimmed);
    margin-top: 0;
    margin-bottom: calc(var(--unit) * 1);
  }
  .post-title {
    font-size: var(--font-size-7);
    line-height: var(--line-height-7);
    letter-spacing: var(--letter-spacing-7);
    font-weight: 600;
    margin: 0;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .post-description {
    font-size: var(--font-size-2);
    line-height: var(--line-height-2);
    letter-spacing: var(--letter-spacing-2);
    color: var(--foreground-color-dimmed);
    margin-top: 0;
    margin-bottom: calc(var(--unit) * 4);
  }
  .post-image {
    margin-bottom: calc(var(--unit) * 4);
    background: rgba(var(--foreground-color-rgb), 0.06);
    line-height: 0;
  }
  .post-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .post-empty {
    color: var(--foreground-color-dimmed);
  }
  @media (max-width: 600px) {
    .back-arrow {
      font-size: var(--font-size-7);
      line-height: var(--line-height-7);
      letter-spacing: var(--letter-spacing-7);
    }
  }
  .post-body :global(h2) {
    font-size: var(--font-size-5);
    line-height: var(--line-height-5);
    letter-spacing: var(--letter-spacing-5);
    font-weight: 600;
    margin-top: calc(var(--unit) * 6);
    margin-bottom: calc(var(--unit) * 1);
  }
  .post-body :global(h3) {
    font-size: var(--font-size-4);
    line-height: var(--line-height-4);
    letter-spacing: var(--letter-spacing-4);
    font-weight: 600;
    margin-top: calc(var(--unit) * 4);
    margin-bottom: calc(var(--unit) * 1);
  }
  .post-body :global(p) {
    font-size: var(--font-size-3);
    line-height: var(--line-height-3);
    letter-spacing: var(--letter-spacing-3);
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    font-size: var(--font-size-3);
    line-height: var(--line-height-3);
    letter-spacing: var(--letter-spacing-3);
    padding-left: calc(var(--unit) * 4);
  }
  .post-body :global(blockquote) {
    border-left: 2px solid var(--foreground-color-dimmed);
    padding-left: calc(var(--unit) * 2);
    color: var(--foreground-color-dimmed);
    margin-left: 0;
  }
  .post-body :global(a[href]) {
    text-decoration: underline;
  }
</style>
