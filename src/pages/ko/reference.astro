---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Menu from '../../components/Menu.astro';
import ReferenceCard from '../../components/ReferenceCard.astro';
import { useTranslations } from '../../i18n/utils';
import { profile } from '../../data/profile';
import { references } from '../../data/reference';

const lang = 'ko' as const;
const t = useTranslations(lang);
---
<BaseLayout
  lang={lang}
  pageClass="page-reference"
  title={`${t('page.reference')} — ${profile.name[lang]}`}
>
  <r-grid class="main" columns="6" columns-s="4" columns-xs="2">
    <r-cell order="-10" span="4" span-s="2">
      <h1>{t('page.reference.heading')}</h1>
    </r-cell>
    <r-cell order="-9" class="menu" span="2" span-s="2">
      <Menu lang={lang} current="reference" />
    </r-cell>
    {references.map((e) => (
      <r-cell span="2" span-s="2" span-xs="row">
        <ReferenceCard entry={e} lang={lang} />
      </r-cell>
    ))}
  </r-grid>
</BaseLayout>
