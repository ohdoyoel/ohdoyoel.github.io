---
import BaseLayout from '../layouts/BaseLayout.astro';
import Menu from '../components/Menu.astro';
import Entry from '../components/Entry.astro';
import { useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';
import { projects } from '../data/project';

const lang = 'en' as const;
const t = useTranslations(lang);
---
<BaseLayout
  lang={lang}
  pageClass="page-project"
  title={`${t('page.project')} — ${profile.name[lang]}`}
>
  <r-grid class="main" columns="6" columns-s="4" columns-xs="2">
    <r-cell order="-10" span="4" span-s="2">
      <h1>{t('page.project.heading')}</h1>
    </r-cell>
    <r-cell order="-9" class="menu" span="2" span-s="2">
      <Menu lang={lang} current="project" />
    </r-cell>
    <r-cell span="6" span-s="4" span-xs="row">
      {projects.map((e) => <Entry entry={e} lang={lang} />)}
    </r-cell>
  </r-grid>
</BaseLayout>
