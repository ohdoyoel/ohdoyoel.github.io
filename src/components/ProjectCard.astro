---
import type { Entry } from '../data/types';
import type { Lang } from '../i18n/ui';
import { assetLink, useTranslations } from '../i18n/utils';

interface Props { entry: Entry; lang: Lang }
const { entry, lang } = Astro.props;
const t = useTranslations(lang);

const isAbsolute = (s: string) => /^([a-z]+:)?\/\//i.test(s) || s.startsWith('/') || s.startsWith('data:');
const resolveHref = (s: string) => (s.startsWith('#') || isAbsolute(s) ? s : assetLink(s));
const imageSrc = entry.image && resolveHref(entry.image.src);
const imageAlt = entry.image?.alt?.[lang] ?? entry.title[lang];
const linkHref = entry.link && resolveHref(entry.link.href);
const linkAttrs = entry.link?.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' };
const period = entry.period.replace(/Present/g, t('meta.present'));
---
<div class="project-card">
  <div class="project-image">
    {imageSrc ? (
      entry.link
        ? <a href={linkHref} {...linkAttrs}><img src={imageSrc} alt={imageAlt} loading="lazy" /></a>
        : <img src={imageSrc} alt={imageAlt} loading="lazy" />
    ) : (
      entry.link
        ? <a href={linkHref} {...linkAttrs} class="project-placeholder-link" aria-label={entry.title[lang]}><div class="project-placeholder" aria-hidden="true" /></a>
        : <div class="project-placeholder" aria-hidden="true" />
    )}
  </div>
  <div class="project-content">
    <p class="subtitle">
      {entry.subtitle ? <>{entry.subtitle[lang]} · <time>{period}</time></> : <time>{period}</time>}
    </p>
    <h3>
      {entry.link
        ? <a href={linkHref} {...linkAttrs}>{entry.title[lang]}</a>
        : entry.title[lang]}
    </h3>
    {entry.description && <p class="description">{entry.description[lang]}</p>}
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
  }
  .project-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgba(var(--foreground-color-rgb), 0.06);
    line-height: 0;
    margin-bottom: calc(var(--unit) * 2);
  }
  .project-image a {
    position: absolute;
    inset: 0;
    display: block;
  }
  .project-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .project-placeholder {
    width: 100%;
    height: 100%;
  }
  .project-placeholder-link {
    position: absolute;
    inset: 0;
    display: block;
  }
  .project-placeholder-link:hover {
    background-color: transparent;
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
  }
  .project-content {
    min-width: 0;
  }
  .project-content h3 {
    font-size: var(--font-size-4);
    line-height: 22px;
    letter-spacing: var(--letter-spacing-4);
    font-weight: 600;
    margin-bottom: var(--h3-margin-bottom);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .project-content h3 > a[href] {
    display: inline;
    white-space: normal;
  }
  .project-content h3 > a[href]:hover {
    background-color: transparent;
    border-radius: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
    text-decoration: underline;
  }
  .project-content p {
    margin-bottom: 0;
  }
  .project-content .subtitle {
    font-size: var(--font-size-1);
    line-height: var(--line-height-1);
    letter-spacing: var(--letter-spacing-1);
    color: var(--foreground-color-dimmed);
    margin-bottom: var(--h3-margin-bottom);
  }
  .project-content .description {
    font-size: var(--font-size-2);
    line-height: var(--line-height-2);
    letter-spacing: var(--letter-spacing-2);
  }
</style>
